      "permission": {
        "edit": "ask",
        "bash": {
          "ls *": "allow",
          "cat *": "allow",
          "*": "ask"
        }
      },
      "skills": ["multi-doc-reasoning-skill", "citation-engine-skill", "market-adapter-skill"]
    },
    "ticker-resolver": {
